# FHIR server (HAPI, Docker sidecar)
PORT_FHIR=8080
FHIR_BASE_URL=http://localhost:8080/fhir/r4

# Stub payer services
PORT_CDS=3001
PORT_DTR=3002
PORT_PAS=3003

# Override to point at an external payer instead of local stubs
PAYER_CDS_BASE_URL=http://localhost:3001
PAYER_DTR_BASE_URL=http://localhost:3002
PAYER_PAS_BASE_URL=http://localhost:3003

# Logging: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# PAS async scenario: seconds to wait before $inquire resolves (0 = instant)
PEND_DELAY_SECONDS=0

# Set to true to enable JWT bearer validation on stub services
ENABLE_AUTH=false
